# Copie para .env e ajuste. NUNCA commite o .env.
#
# APP_ENV: "desenvolvimento" mostra erros do PHP na tela; qualquer outro valor (use "producao")
# esconde os detalhes e só grava em storage/logs. Em demonstração/entrega, use producao.
APP_ENV=desenvolvimento
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fiscalpulse
# Banco usado SÓ pelos testes de integração (é apagado e recriado). Deve terminar em _teste.
DB_NAME_TESTE=fiscalpulse_teste
DB_USER=root
DB_PASS=
